{
  "id": "fedora",
  "backend": "dnf-installroot",
  "arch": "aarch64",
  "container_image": "registry.fedoraproject.org/fedora",
  "base_packages": [
    "@core",
    "systemd",
    "systemd-sysv",
    "sudo",
    "curl",
    "dbus",
    "ca-certificates",
    "NetworkManager",
    "NetworkManager-wifi",
    "NetworkManager-tui",
    "openssh-server",
    "openssh-clients",
    "wpa_supplicant",
    "iw",
    "kmod",
    "util-linux",
    "busybox",
    "python3",
    "f2fs-tools",
    "selinux-policy-targeted",
    "policycoreutils",
    "libselinux-utils",
    "bluez",
    "qrtr",
    "rmtfs",
    "tqftpserv",
    "fastrpc",
    "alsa-utils",
    "alsa-ucm",
    "rtkit",
    "polkit",
    "cracklib-dicts",
    "lm_sensors"
  ],
  "dnf_options": [
    "--use-host-config",
    "--exclude=kernel*",
    "--setopt=install_weak_deps=False",
    "--setopt=tsflags=nodocs"
  ]
}
